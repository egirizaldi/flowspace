# ========================================================
# FLOWSPACE SAAS — DOCKER PRODUCTION ENVIRONMENT TEMPLATE
# ========================================================

# -----------------
# 1. DATABASE (POSTGRESQL)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password_change_me
POSTGRES_DB=flowspace_prod
POSTGRES_PORT=5432

# -----------------
# 2. REDIS
# -----------------
REDIS_PORT=6379

# -----------------
# 3. AUTHENTICATION (SESSION COOKIE)
# -----------------
SESSION_COOKIE_NAME=flowspace_session
SESSION_SECRET=generate-a-strong-random-session-secret-string-min-32-chars
SESSION_EXPIRES_IN=7d

# -----------------
# 4. APP URLS
# -----------------
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# -----------------
# 5. TRANSACTIONAL EMAIL (SMTP)
# -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="FlowSpace <no-reply@flowspace.com>"

# -----------------
# 6. OBJECT STORAGE (CLOUDFLARE R2)
# -----------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flowspace-attachments
