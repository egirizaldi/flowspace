# =============================================
# FlowSpace — Environment Variables Template
# Salin file ini menjadi .env dan sesuaikan nilainya
# =============================================

# Environment
NODE_ENV="development"

# Application URLs & Ports
APP_PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Database PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowspace_dev?schema=public"

# Redis (Opsional untuk MVP awal, diaktifkan saat background jobs/realtime)
REDIS_URL="redis://localhost:6379"

# Session Cookie Authentication
SESSION_COOKIE_NAME="flowspace_session"
SESSION_SECRET="your-super-secret-session-key-change-in-production-min-32-chars"
SESSION_EXPIRES_IN="7d"

# Email (SMTP) — Verifikasi email & reset password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@flowspace.com"

# Cloudflare R2 Storage (Fase Attachment)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flowspace-attachments"
