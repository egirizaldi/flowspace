# =============================================
# FlowSpace API — Environment Variables Template
# =============================================

NODE_ENV="development"

# Server Port & URLs
APP_PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowspace_dev?schema=public"

# Redis (Future/Queue)
REDIS_URL="redis://localhost:6379"

# Session Security Configuration
SESSION_COOKIE_NAME="flowspace_session"
SESSION_SECRET="replace-with-a-secure-random-32-char-secret-key-in-production"
SESSION_EXPIRES_IN="7d"

# SMTP Mail Server (Invitations & Password Resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@flowspace.internal"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@flowspace.internal"

# Cloudflare R2 / S3 Object Storage (Attachments)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flowspace-attachments"
